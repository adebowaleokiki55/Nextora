# Copy to .env (never commit .env). All values are optional.

# ---------------------------------------------------------------
# AI provider: pick ONE block. Any provider with an API key works.
# ---------------------------------------------------------------

# Anthropic Claude
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5          # or set CLAUDE_MODEL

# Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Together, Mistral,
# DeepSeek, Gemini's OpenAI endpoint, LM Studio, vLLM, Ollama /v1 ...)
# LLM_PROVIDER=openai
# LLM_API_KEY=...
# LLM_MODEL=<a model name your provider offers>
# LLM_BASE_URL=https://api.openai.com/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai

# Ollama (native API, local or Ollama Cloud) - the original Nextora setup
# LLM_PROVIDER=ollama
# OLLAMA_API_KEY=...                 # not needed for a local server
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_URL=https://ollama.com/api/chat   # local: http://localhost:11434/api/chat

# Shortcut: with no LLM_PROVIDER set, the first of ANTHROPIC_API_KEY,
# OPENAI_API_KEY or OLLAMA_API_KEY found is used.

# ---------------------------------------------------------------
# Database: SQLite file in data/ by default; PostgreSQL in deployment
# ---------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/nextora

# ---------------------------------------------------------------
# Other
# ---------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example
# LAB_MODEL_PATH=model.pth
